# systemd user service, rendered by `./install.sh --service` (@...@ placeholders are filled in, with
# systemd escaping: paths may contain spaces).
# Manage it with: systemctl --user status|restart|stop colab-studio, logs: journalctl --user -u colab-studio
[Unit]
Description=Colab Studio
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@REPO@/server
Environment="PATH=@PATH@"
ExecStart="@REPO@/.venv/bin/python" app.py
# Only the main process gets SIGTERM first: it stops the queue, then releases the GPU runtime.
KillMode=mixed
# Releasing the runtimes can take several minutes (ssh exit, colab stop per session, leftovers).
TimeoutStopSec=660
# If shutdown was cut short anyway, release every runtime the studio may still own: the default
# session plus the extra sessions listed in the registry (errors ignored).
ExecStopPost=-"@REPO@/deploy/colab-stop-all.sh"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
