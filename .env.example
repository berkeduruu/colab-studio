# Colab Studio settings. install.sh copies this file to .env; edit .env and restart the studio.
# .env is git-ignored: your token never leaves this machine.

# Who can open the web UI:
#   127.0.0.1  only this computer (default, recommended)
#   0.0.0.0    any device that can reach this machine by IP. There is NO password: anyone who can
#              open the page can start the GPU and spend your Colab compute units. Use a firewall,
#              an SSH tunnel, or a domain with nginx + a password (deploy/setup-nginx.sh).
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8190

# Hugging Face read token (optional, https://huggingface.co/settings/tokens). The default models are
# public, but anonymous downloads are slower and can hit rate limits (HTTP 429).
HF_TOKEN=

# Release the GPU after this many idle minutes (an L4 costs Colab compute units while it runs).
STUDIO_IDLE_MINUTES=15

# Where chats, generated media, learned timings and the studio's own SSH key are stored.
# STUDIO_DATA=~/.local/share/colab-studio

# Model catalog. Default: models.toml in the repository root if it exists, otherwise
# station/models.default.toml. See the "Models" section of the README.
# STUDIO_MODELS=

# Path of the colab CLI if it is not on PATH.
# COLAB_BIN=

# Name of the Colab session the studio owns. Other sessions on your account are never touched.
# STUDIO_SESSION=studio
